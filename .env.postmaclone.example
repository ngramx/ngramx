# Optional override — prefer postmaclone.backup.credentials in ngramx.yml instead.
# If you use this file:
#
#   op run --env-file=.env.postmaclone -- ngramx postmaclone
#
# Field names must match the 1Password item — use "Copy Secret Reference" if unsure.

POSTMACLONE_S3_KEY="op://Tech Team Vault/ngramx-db-backup-read-access/username"
POSTMACLONE_S3_SECRET="op://Tech Team Vault/ngramx-db-backup-read-access/password"

