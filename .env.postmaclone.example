# Post Maclone env overrides (gitignored as .env.postmaclone).
#
# Required when ngramx.yml has postmaclone.backup.source: connection.
# Put this in project `.env` or copy to `.env.postmaclone`. Credentials must
# not go in ngramx.yml. URL-encode special characters in the password.
#
#   POSTMACLONE_SOURCE_URL=mysql://USER:PASSWORD@HOST:3306/DATABASE
#
# Then run: ngramx postmaclone
# Or:       op run --env-file=.env.postmaclone -- ngramx postmaclone

POSTMACLONE_SOURCE_URL=mysql://readonly:change-me@127.0.0.1:3306/app

# Optional S3/Spaces override — prefer postmaclone.backup.credentials in ngramx.yml instead.
# If you use this file for Spaces:
#
#   op run --env-file=.env.postmaclone -- ngramx postmaclone
#
# Field names must match the 1Password item — use "Copy Secret Reference" if unsure.

# POSTMACLONE_S3_KEY="op://Tech Team Vault/ngramx-db-backup-read-access/username"
# POSTMACLONE_S3_SECRET="op://Tech Team Vault/ngramx-db-backup-read-access/password"
