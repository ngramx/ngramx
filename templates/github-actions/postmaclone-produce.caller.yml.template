# Generated by: ngramx init-postmaclone-workflow
#
# Nightly factory produce: pull prod dump → restore scratch (remote DO cluster) →
# anonymize → publish artifact + latest.json → refresh shared hosted DB.
#
# Required repository secrets:
#   OP_SERVICE_ACCOUNT_TOKEN — read Tech Team Vault (backup read, anon write, DB URLs)
#
# Optional repository secrets (override factory postmaclone.yml op:// refs):
#   POSTMACLONE_REMOTE_URL — scratch database URL when target.provider is remote
#
# Install clients and ngramx on first run; failures surface in Actions (no silent stale DB).

name: Postmaclone produce

on:
  schedule:
    - cron: '{{CRON}}'
  workflow_dispatch:

concurrency:
  group: postmaclone-produce
  cancel-in-progress: false

jobs:
  produce:
    runs-on: ubuntu-latest
    timeout-minutes: 360

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup PHP
        uses: shivammathur/setup-php@v2
        with:
          php-version: '{{PHP_VERSION}}'
          extensions: mbstring, xml, ctype, json

      - name: Install database clients
        run: |
          sudo apt-get update
          sudo apt-get install -y postgresql-client mysql-client gzip

      - name: Install 1Password CLI
        uses: 1password/install-cli-action@v2

      - name: Download ngramx
        run: |
          curl -fsSL -o ngramx.phar "{{NGRAMX_DOWNLOAD_URL}}"
          chmod +x ngramx.phar
          php ngramx.phar --version

      - name: Produce anonymized datasets
        env:
          OP_SERVICE_ACCOUNT_TOKEN: ${{ secrets.OP_SERVICE_ACCOUNT_TOKEN }}
          POSTMACLONE_REMOTE_URL: ${{ secrets.POSTMACLONE_REMOTE_URL }}
        run: |
          set -euo pipefail
          php ngramx.phar postmaclone produce {{PRODUCE_ARGS}} --config {{CONFIG_PATH}}
