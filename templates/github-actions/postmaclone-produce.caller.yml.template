# Generated by: ngramx init-postmaclone-workflow
#
# Nightly factory produce: pull prod dump → restore scratch (remote DO cluster) →
# anonymize → publish artifact + latest.json → refresh shared hosted DB.
#
# Required repository secrets:
#   OP_SERVICE_ACCOUNT_TOKEN — read Tech Team Vault (backup read, anon write, DB URLs)
#
# Optional repository secrets (override factory postmaclone.yml op:// refs):
#   POSTMACLONE_REMOTE_URL — scratch database URL when target.provider is remote
#
# Install clients and ngramx on first run; failures surface in Actions (no silent stale DB).

name: Postmaclone produce

on:
  schedule:
    - cron: '{{CRON}}'
  workflow_dispatch:

concurrency:
  group: postmaclone-produce
  cancel-in-progress: false

jobs:
  produce:
    runs-on: ubuntu-latest
    timeout-minutes: 360

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup PHP
        uses: shivammathur/setup-php@v2
        with:
          php-version: '{{PHP_VERSION}}'
          extensions: mbstring, xml, ctype, json, pdo_pgsql, pdo_mysql

      - name: Install database clients
        run: |
          set -euo pipefail
          sudo apt-get update
          sudo apt-get install -y ca-certificates curl gnupg mysql-client gzip
          curl -fsSL https://www.postgresql.org/media/keys/ACCC4CF8.asc \
            | sudo gpg --dearmor -o /usr/share/keyrings/postgresql.gpg
          echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/postgresql.gpg] https://apt.postgresql.org/pub/repos/apt $(. /etc/os-release && echo "$VERSION_CODENAME")-pgdg main" \
            | sudo tee /etc/apt/sources.list.d/pgdg.list
          sudo apt-get update
          sudo apt-get install -y postgresql-client-17
          test -x /usr/lib/postgresql/17/bin/pg_dump
          echo "/usr/lib/postgresql/17/bin" >> "$GITHUB_PATH"
          /usr/lib/postgresql/17/bin/pg_dump --version
          /usr/lib/postgresql/17/bin/pg_dump --version | grep -E ' \(PostgreSQL\) 17\.'

      - name: Install 1Password CLI
        uses: 1password/install-cli-action@v2

      - name: Download ngramx
        run: |
          curl -fsSL -o ngramx.phar "{{NGRAMX_DOWNLOAD_URL}}"
          chmod +x ngramx.phar
          php ngramx.phar --version

      - name: Produce anonymized datasets
        env:
          OP_SERVICE_ACCOUNT_TOKEN: ${{ secrets.OP_SERVICE_ACCOUNT_TOKEN }}
          POSTMACLONE_REMOTE_URL: ${{ secrets.POSTMACLONE_REMOTE_URL }}
        run: |
          set -euo pipefail
          export PATH="/usr/lib/postgresql/17/bin:$PATH"
          pg_dump --version | grep -E ' \(PostgreSQL\) 17\.'
          stdbuf -oL -eL php -d output_buffering=Off -d implicit_flush=1 ngramx.phar postmaclone produce {{PRODUCE_ARGS}} --config {{CONFIG_PATH}}
