# Generated by: ngramx init-github-actions
# Calls reusable workflow: {{SHARED_REPO}} @ {{SHARED_REF}}
#
# On a pull request into {{BASE_BRANCH}}, the shared workflow asks Claude to
# apply one risk label ({{RISK_LOW_LABEL}}, risk:medium, or {{RISK_HIGH_LABEL}}).
# {{RISK_HIGH_LABEL}} disables GitHub auto-merge and removes `{{AUTO_MERGE_LABEL}}`.
# The job then fails until the pull request has one approving review. Submitting
# or dismissing a review re-runs the check: one approval (including the author's)
# turns it green, and dismissing that approval turns it red again. Every other
# risk passes with no review.
#
# GitHub rulesets cannot require an approval just because a label is present.
# Make this job a required status check on {{BASE_BRANCH}} and do not require
# approving reviews for every PR. Add the check only after this file is on the
# default branch. Until then the check never runs and a required-check rule
# would block every merge.
#
# Required secret (org or repo), passed with secrets: inherit:
#   ANTHROPIC_API_KEY

name: high-risk-review

on:
  pull_request:
    types: [opened, reopened, synchronize, ready_for_review, labeled, unlabeled, edited]
    branches:
      - '{{BASE_BRANCH}}'
  pull_request_review:
    types: [submitted, dismissed]

permissions:
  contents: read
  pull-requests: write
  issues: write

jobs:
  high-risk-review:
    # GitHub ignores branches on pull_request_review, so the base ref is checked here.
    # edited is included above so changing the base onto this branch runs the gate again.
    if: github.event_name != 'pull_request_review' || github.event.pull_request.base.ref == '{{BASE_BRANCH}}'
    uses: {{SHARED_REPO}}/.github/workflows/high-risk-review.yml@{{SHARED_REF}}
    secrets: inherit
    with:
      risk-low-label: '{{RISK_LOW_LABEL}}'
      risk-high-label: '{{RISK_HIGH_LABEL}}'
      auto-merge-label: '{{AUTO_MERGE_LABEL}}'
